{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glint",
  "version": "0.1.0",
  "identifier": "com.admin.glint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glint",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "command-bar",
        "title": "Glint command bar",
        "url": "index.html",
        "width": 480,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../Glint.Phase0.Cli/bin/Release/net9.0-windows10.0.22621.0/*",
      "../../../tools/litert/worker.py",
      "../../../tools/litert/requirements.txt"
    ]
  }
}
