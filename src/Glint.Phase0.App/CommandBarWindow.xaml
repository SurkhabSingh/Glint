<Window
    x:Class="Glint.Phase0.App.CommandBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glint command bar">
    <Border
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Padding="14">
        <StackPanel Spacing="10">
            <Grid x:Name="DragRegion" Height="18">
                <Border
                    Width="42"
                    Height="5"
                    Background="{ThemeResource TextFillColorTertiaryBrush}"
                    CornerRadius="3"
                    HorizontalAlignment="Center" />
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8">
                    <TextBlock
                        Text="G"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="White" />
                </Border>
                <TextBox
                    x:Name="CommandTextBox"
                    Grid.Column="1"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="18"
                    PlaceholderText="Type a command or search your context"
                    KeyDown="CommandTextBox_KeyDown" />
                <TextBlock
                    Grid.Column="2"
                    Text="Enter"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    FontSize="12" />
            </Grid>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="4">
                <Button
                    Tag="capture this"
                    Click="Suggestion_Click"
                    HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE722;" />
                        <TextBlock Grid.Column="1" Text="capture this" />
                    </Grid>
                </Button>
                <Button
                    Tag="start scanning"
                    Click="Suggestion_Click"
                    HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE768;" />
                        <TextBlock Grid.Column="1" Text="start scanning" />
                    </Grid>
                </Button>
                <Button
                    Tag="pause scanning"
                    Click="Suggestion_Click"
                    HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE769;" />
                        <TextBlock Grid.Column="1" Text="pause scanning" />
                    </Grid>
                </Button>
                <Button
                    Tag="search your context"
                    Click="Suggestion_Click"
                    HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" />
                        <TextBlock Grid.Column="1" Text="search your context" />
                    </Grid>
                </Button>
                <Button
                    Tag="open Glint"
                    Click="Suggestion_Click"
                    HorizontalContentAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A7;" />
                        <TextBlock Grid.Column="1" Text="open Glint" />
                    </Grid>
                </Button>
            </StackPanel>

            <TextBlock
                Text="Ctrl+Alt+G toggles this command bar. Esc closes it."
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                FontSize="12" />
        </StackPanel>
    </Border>
</Window>
