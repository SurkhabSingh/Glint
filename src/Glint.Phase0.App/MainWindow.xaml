<Window
    x:Class="Glint.Phase0.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glint">
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Activity" Tag="activity">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Search" Tag="search">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <ScrollViewer x:Name="ActivityPage">
                <Grid Padding="28" MaxWidth="980" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Glint" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Local context capture"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="Glint lives in the system tray. Press Ctrl+Alt+G anywhere to open the command bar."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="{x:Bind ViewModel.OverallSeverity, Mode=OneWay}"
                            Title="{x:Bind ViewModel.OverallTitle, Mode=OneWay}"
                            Message="{x:Bind ViewModel.OverallMessage, Mode=OneWay}" />
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Capture" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="Start scanning, switch between windows, and Glint will capture changed context until paused."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ModelSummary, Mode=OneWay}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Content="Start scanning"
                                    Command="{x:Bind ViewModel.StartScanningCommand}" />
                                <Button
                                    Content="Pause scanning"
                                    Command="{x:Bind ViewModel.PauseScanningCommand}" />
                                <Button
                                    Content="Enable borderless capture"
                                    Command="{x:Bind ViewModel.BorderlessCommand}" />
                                <Button
                                    Content="Import Gemma model..."
                                    Click="ImportGemmaModel_Click"
                                    ToolTipService.ToolTip="Pick a .litertlm Gemma model already on disk." />
                            </StackPanel>
                            <ProgressRing
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.CaptureSummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,20,0,0" Spacing="8">
                        <TextBlock Text="Scanned activity" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.HistorySummary, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="3"
                        Margin="0,12,0,24"
                        ItemsSource="{x:Bind ViewModel.ScanHistory, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="12">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            Text="{Binding TimestampText}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12" />
                                        <TextBlock
                                            Text="{Binding Label}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding ImportantText}"
                                            Visibility="{Binding ImportantVisibility}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding ReminderText}"
                                            Visibility="{Binding ReminderVisibility}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding SourceText}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding MetricsText}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            FontSize="12"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding StatusText}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12" />
                                        <Expander
                                            Header="Inspect redacted OCR/UIA input"
                                            Visibility="{Binding DiagnosticsVisibility}">
                                            <StackPanel Spacing="8">
                                                <TextBlock
                                                    Text="{Binding InputSummaryText}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Text="Combined redacted text used for Gemma context selection"
                                                    FontWeight="SemiBold" />
                                                <ScrollViewer MaxHeight="240">
                                                    <TextBlock
                                                        Text="{Binding RedactedInputText}"
                                                        FontFamily="Consolas"
                                                        TextWrapping="Wrap" />
                                                </ScrollViewer>
                                                <TextBlock
                                                    Text="OCR text only"
                                                    FontWeight="SemiBold"
                                                    Visibility="{Binding OcrDiagnosticsVisibility}" />
                                                <ScrollViewer
                                                    MaxHeight="180"
                                                    Visibility="{Binding OcrDiagnosticsVisibility}">
                                                    <TextBlock
                                                        Text="{Binding RedactedOcrText}"
                                                        FontFamily="Consolas"
                                                        TextWrapping="Wrap" />
                                                </ScrollViewer>
                                                <TextBlock
                                                    Text="UI Automation text only"
                                                    FontWeight="SemiBold"
                                                    Visibility="{Binding UiAutomationDiagnosticsVisibility}" />
                                                <ScrollViewer
                                                    MaxHeight="180"
                                                    Visibility="{Binding UiAutomationDiagnosticsVisibility}">
                                                    <TextBlock
                                                        Text="{Binding RedactedUiAutomationText}"
                                                        FontFamily="Consolas"
                                                        TextWrapping="Wrap" />
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="SearchPage" Visibility="Collapsed">
                <Grid Padding="28" MaxWidth="900" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Search" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Find a person, application, topic, summary, or phrase in your encrypted local context."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="SearchBox"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="18"
                                PlaceholderText="Search your memory"
                                KeyDown="SearchBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                Content="Search"
                                Command="{x:Bind ViewModel.SearchCommand}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,16,0,24" Spacing="10">
                        <TextBlock
                            Text="{x:Bind ViewModel.SearchSummary, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="12">
                                        <StackPanel Spacing="5">
                                            <TextBlock
                                                Text="{Binding TimestampText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock
                                                Text="{Binding Label}"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding ImportantText}"
                                                Visibility="{Binding ImportantVisibility}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding ReminderText}"
                                                Visibility="{Binding ReminderVisibility}"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding Snippet}"
                                                FontFamily="Consolas"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding SourceText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed">
                <Grid Padding="28" MaxWidth="980" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Diagnostics" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Privacy, encrypted storage, and machine compatibility checks."
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Foreground privacy gate"
                                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ForegroundSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Content="Run privacy probe"
                                    Command="{x:Bind ViewModel.ProbeCommand}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="12">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="Encrypted local storage"
                                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.StorageSummary, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Content="Verify storage"
                                    Command="{x:Bind ViewModel.StorageCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Machine compatibility"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.CompatibilitySummary, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Content="Run compatibility check"
                                Command="{x:Bind ViewModel.CompatibilityCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,20,0,24"
                        Text="Captured pixels stay in memory. Only redacted text and derived summaries are stored in the encrypted local database."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
