<Window
    x:Class="Glint.Phase0.WpfTarget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glint WPF Compatibility Target"
    Width="720"
    Height="420"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Glint WPF compatibility target" />
            <TextBlock
                Margin="0,16,0,0"
                FontSize="18"
                Text="This known-safe text validates UI Automation, Windows Graphics Capture, and OCR." />
            <TextBlock
                x:Name="ModeText"
                Margin="0,16,0,0"
                FontSize="18"
                Text="Mode: normal" />
            <Button
                Margin="0,24,0,0"
                Width="180"
                HorizontalAlignment="Left"
                Content="Known safe control" />
        </StackPanel>
    </Grid>
</Window>
